    "Quit MixPill (⌘Q)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MixPill’den Çık (⌘Q)"
          }
        }
      }
    },
    "Read back from the mixer itself, not from the sliders. If a channel here does not match what you set, the setting stopped somewhere between the interface and the engine.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürgülerden değil, doğrudan mikserin kendisinden okunur. Buradaki bir kanal ayarladığınızla uyuşmuyorsa, ayar arayüzle motor arasında bir yerde kalmış demektir."
          }
        }
      }
    },
    "Rebuilds every output engine and re-applies routing without restarting the app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı yeniden başlatmadan bütün çıkış motorlarını kurar ve yönlendirmeyi yeniden uygular"
          }
        }
      }
    },
    "Rebuilds the entire output graph and re-arms captures. Takes under a second; no app restart needed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün çıkış grafiğini yeniden kurar ve yakalamaları yeniden hazırlar. Bir saniyeden kısa sürer; uygulamayı yeniden başlatmak gerekmez."
          }
        }
      }
    },
    "Recovery": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma"
          }
        }
      }
    },
    "Reduces audio delay for live monitoring and lip-synced video at slightly higher CPU usage": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı monitör ve dudak senkronu için ses gecikmesini azaltır, karşılığında biraz daha CPU kullanır"
          }
        }
      }
    },
    "Replace this preset with the mixer's current state": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu preset’i mikserin şu anki durumuyla değiştir"
          }
        }
      }
    },
