          }
        }
      }
    },
    "Focus Shield is off: click to block background apps from stealing keyboard focus": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak Kalkanı kapalı: arka plandaki uygulamaların klavye odağını çalmasını engellemek için tıklayın"
          }
        }
      }
    },
    "Focus Shield is on: background apps cannot steal keyboard focus": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak Kalkanı açık: arka plandaki uygulamalar klavye odağını çalamaz"
          }
        }
      }
    },
    "Focus Shield is waiting for permission. Allow MixPill in System Settings › Privacy & Security › Accessibility and it turns itself on. Click to cancel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak Kalkanı izin bekliyor. Sistem Ayarları › Gizlilik ve Güvenlik › Erişilebilirlik altında MixPill’e izin verin, kendiliğinden açılır. Vazgeçmek için tıklayın."
          }
        }
      }
    },
