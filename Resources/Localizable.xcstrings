            "value": "Özel"
          }
        }
      }
    },
    "DAW Direct for %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için DAW Direct"
          }
        }
      }
    },
    "DAW Direct is off, so %@ is mixed like any other app. Turn it on to hand it back its own output path.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW Direct kapalı, yani %@ diğer uygulamalar gibi mikslenir. Kendi çıkış yolunu geri vermek için açın."
          }
        }
      }
    },
    "DAW Direct is on: MixPill leaves %@ completely alone, so its own outputs, routing and monitoring latency are untouched. Turn it off to mix it here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DAW Direct açık: MixPill %@ uygulamasına hiç dokunmaz; kendi çıkışları, yönlendirmesi ve monitör gecikmesi olduğu gibi kalır. Burada mikslemek için kapatın."
          }
        }
      }
    },
    "Delete preset": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset’i sil"
