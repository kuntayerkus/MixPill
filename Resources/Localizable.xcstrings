            "value": "%@ bandını 0 dB’ye sıfırla"
          }
        }
      }
    },
    "Restore a saved preset": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bir preset’i geri yükle"
          }
        }
      }
    },
    "Restores audio for %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasının sesini geri açar"
          }
        }
      }
    },
    "Restores every app's saved volume, mute, equalizer, noise gate and output from one of your presets.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset’lerinizden birinden her uygulamanın kayıtlı ses düzeyini, sessizliğini, ekolayzerini, noise gate’ini ve çıkışını geri yükler."
          }
        }
      }
    },
    "Route %@ to %@": {
