    "Choose the output for each application. “System Default” follows whatever macOS is using.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulama için çıkışı seçin. “System Default”, macOS hangi cihazı kullanıyorsa onu izler."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
