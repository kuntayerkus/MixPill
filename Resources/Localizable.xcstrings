{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ audio controls": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ses denetimleri"
          }
        }
      }
    },
    "%@ could not be captured; MixPill is not controlling it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yakalanamadı; MixPill bu uygulamayı denetlemiyor"
          }
        }
      }
    },
    "%@ is using the microphone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mikrofonu kullanıyor"
          }
        }
      }
    },
    "%@ plays directly; MixPill is not controlling it": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doğrudan çalıyor; MixPill bu uygulamayı denetlemiyor"
          }
        }
      }
    },
    "%@ plays on %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ plays on %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ şurada çalıyor: %@"
          }
        }
      }
    },
    "%@ volume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ses düzeyi"
          }
        }
      }
    },
    "%@, %lld percent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$lld percent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, yüzde %lld"
          }
        }
      }
    },
    "%@, %lld percent of normal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$lld percent of normal"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, normalin yüzde %lld’i"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%lld Quiet Apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Sessiz Uygulama"
          }
        }
      }
    },
    "%lld apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld uygulama"
          }
        }
      }
    },
    "%lld output targets available. Pairs on a multi-channel interface are grouped under their device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld çıkış hedefi var. Çok kanallı arayüzlerdeki çiftler kendi cihazlarının altında gruplanır."
          }
        }
      }
    },
    "%lld%% of normal volume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal ses düzeyinin %%%lld’i"
          }
        }
      }
    },
    "0 dB max": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "en çok 0 dB"
          }
        }
      }
    },
    "0 to 100 percent.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ile 100 arası yüzde."
          }
        }
      }
    },
    "0 to 200 percent. 100 is normal; above that MixPill boosts the app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ile 200 arası yüzde. 100 normaldir; üzeri MixPill’in uygulamayı yükseltmesidir."
          }
        }
      }
    },
    "1 Quiet App": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Sessiz Uygulama"
          }
        }
      }
    },
    "1 app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 uygulama"
          }
        }
      }
    },
    "100% On-Device & Private": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%100 Cihazda ve Gizli"
          }
        }
      }
    },
    "5-Band Equalizer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Bantlı Ekolayzer"
          }
        }
      }
    },
    "A dropout is audio that stopped arriving in time; a partial block is a gap spliced into audio that kept coming. Both are counted since the engine last started, so what matters is whether they climb while you listen.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesinti, sesin zamanında ulaşmayı bırakmasıdır; kısmi blok ise gelmeye devam eden sesin içine açılan bir boşluktur. İkisi de motorun son açılışından beri sayılır, dolayısıyla önemli olan siz dinlerken artıp artmadıklarıdır."
          }
        }
      }
    },
    "A dropout is audio that stopped arriving in time; a partial block is a gap spliced into audio that kept coming. The clock correction is MixPill continuously resampling to hold your app's audio clock and your output device's together — a steady reading of a few dozen ppm is it working, not a fault. A timing correction is the rarer, coarser fix used when a stall leaves too much to absorb that way. Counts are since the engine last started, so what matters is whether they climb while you listen.": {},
    "A preset captures every app's volume, mute, equalizer, noise gate and output device. Save one from the menu bar popover, then apply it by hand, from an automation rule, or from a Focus filter.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir preset, her uygulamanın ses düzeyini, sessizliğini, ekolayzerini, noise gate’ini ve çıkış cihazını saklar. Menü çubuğundan kaydedin; sonra elle, bir otomasyon kuralıyla ya da bir Odak filtresiyle uygulayın."
          }
        }
      }
    },
    "Accessibility access needed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor"
          }
        }
      }
    },
    "Add Rule": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural Ekle"
          }
        }
      }
    },
    "Add automation rule": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyon kuralı ekle"
          }
        }
      }
    },
    "Adjusts the gain of the %@ band": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bandının kazancını ayarlar"
          }
        }
      }
    },
    "Adjusts the output volume of %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uygulamasının çıkış düzeyini ayarlar"
          }
        }
      }
    },
    "Adjusts the overall output volume of MixPill": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MixPill’in genel çıkış düzeyini ayarlar"
          }
        }
      }
    },
    "Adjusts the overall output volume of MixPill. Maximum is 0 decibels; boost above unity is on each app's own fader.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MixPill’in genel çıkış ses düzeyini ayarlar. Üst sınır 0 desibeldir; birim üstü yükseltme her uygulamanın kendi sürgüsündedir."
          }
        }
      }
    },
    "Anything quieter than this is silenced — useful for a noisy stream or a game's background hiss. All the way left is off.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan sessiz olan her şey susturulur — gürültülü bir yayında ya da bir oyunun zemin uğultusunda işe yarar. Tamamen sola aldığınızda kapalıdır."
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama"
          }
        }
      }
    },
    "Application mixer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama mikseri"
          }
        }
      }
    },
    "Applications": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar"
          }
        }
      }
    },
    "Applied by the Engine": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorun Uyguladığı"
          }
        }
      }
    },
    "Applies a preset and Smart Ducking setting while this Focus is on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Odak açıkken bir preset ve Smart Ducking ayarı uygular."
          }
        }
      }
    },
    "Applies the selected preset when %@ launches.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ açıldığında seçili preset’i uygular."
