      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses Başarımı"
          }
        }
      }
    },
    "Automatically lowers other apps while somebody is speaking on a call": {
      "localizations": {
        "tr": {
