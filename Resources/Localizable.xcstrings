    "Looks once a day and only interrupts you when there is something to install.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde bir kez bakar ve yalnızca kurulacak bir şey varsa sizi rahatsız eder."
          }
        }
      }
    },
    "Master Volume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ses Düzeyi"
          }
        }
      }
    },
    "Master volume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ses düzeyi"
          }
        }
